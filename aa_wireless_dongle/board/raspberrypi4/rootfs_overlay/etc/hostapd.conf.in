ctrl_interface=/var/run/hostapd
interface=wlan0

hw_mode=a
ieee80211n=1
ieee80211ac=1
channel=36

# Enable WMM (Wi-Fi Multimedia) for QoS
wmm_enabled=1

# HT (High Throughput) capabilities for 5GHz
ht_capab=[HT40+][SHORT-GI-20][SHORT-GI-40]

# VHT (Very High Throughput) capabilities for 802.11ac
vht_capab=[MAX-MPDU-11454][SHORT-GI-80][TX-STBC-2BY1][RX-STBC-1]
vht_oper_chwidth=1
vht_oper_centr_freq_seg0_idx=42

auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP

ssid=AAWirelessDongle

#wpa_passphrase=ConnectAAWirelessDongle
#country_code=IN
